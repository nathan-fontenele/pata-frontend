# Auth0 Regular Web Application. Registre http://localhost:3000/callback
# como Allowed Callback URL e http://localhost:3000 como Allowed Logout URL.
AUTH0_DOMAIN=seu-tenant.us.auth0.com
AUTH0_CLIENT_ID=seu_client_id
AUTH0_CLIENT_SECRET=seu_client_secret
# Gere com: openssl rand -hex 32
AUTH0_SECRET=gere_uma_chave_aleatoria_com_32_bytes
APP_BASE_URL=http://localhost:3000

# Identificador da API configurado no Auth0 e aceito pelo backend como audience.
AUTH0_AUDIENCE=

# URL base do backend Pata
PATA_API_URL=http://localhost:8080
