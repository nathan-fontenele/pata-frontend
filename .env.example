# Auth0 Application (SPA ou Regular Web App com Authorization Code Flow)
NEXT_PUBLIC_AUTH0_DOMAIN=seu-tenant.us.auth0.com
NEXT_PUBLIC_AUTH0_CLIENT_ID=seu_client_id

# Opcional: use se sua API estiver protegida pelo Auth0
NEXT_PUBLIC_AUTH0_AUDIENCE=

# URL cadastrada em Allowed Callback URLs no Auth0
NEXT_PUBLIC_AUTH0_REDIRECT_URI=http://localhost:3000/callback
